<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:v2="http://schemas.microsoft.com/appx/2013/desktop"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap v2 rescap">

  <Identity
    Name="AkashSrivastava.GemSuite"
    Publisher="CN=F2A00A4C-D78E-4B4D-B8B5-8F0B6D9A3C5E"
    Version="1.0.5.0" />

  <Properties>
    <DisplayName>Gem Suite</DisplayName>
    <PublisherDisplayName>Akash Srivastava</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" ExecutionAlias="gemsuite.exe" StartPage="shell:appsFolder/AkashSrivastava.GemSuite!App">
      <uap:VisualElements
        DisplayName="Gem Suite"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="AI-powered suite of productivity tools"
        BackgroundColor="transparent" />
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="gemsuite" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- ✅ Allow internet access for Gemini API, OpenAI, and other cloud services -->
    <Capability Name="internetClient" />
    
    <!-- ✅ Allow local network access for localhost server communication -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>

</Package>
