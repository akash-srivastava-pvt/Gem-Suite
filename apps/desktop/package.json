{
  "name": "@gem/desktop",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "dist": "electron-builder --publish=never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akash-srivastava-pvt/Apps.git"
  },
  "dependencies": {
    "@gem/db": "*",
    "@gem/shared": "*",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "electron-log": "^5.4.3",
    "express": "^4.18.2",
    "fs-extra": "^11.3.3",
    "keytar": "^7.9.0",
    "net": "1.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "20.0.0",
    "electron": "28.0.0",
    "electron-builder": "24.9.1",
    "prebuild-install": "^7.1.3",
    "typescript": "latest"
  },
  "build": {
    "appId": "com.gemsuite.app",
    "productName": "GemSuite",
    "asar": true,
    "asarUnpack": [],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "web/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "win": {
      "icon": "../../public/icon.png",
      "target": [
        "nsis"
      ]
    }
  }
}