{
  "name": "@gem/desktop",
  "version": "1.0.0",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "dist": "electron-builder"
  },
  "dependencies": {
    "net": "1.0.2"
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "24.9.1",
    "typescript": "latest",
    "@types/node": "20.0.0"
  },
  "build": {
    "appId": "com.gemsuite.app",
    "productName": "GemSuite",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sql.js/**/*",
      "server/**/*"
    ],
    "directories": {
      "output": "release" 
    },
    "files": [
      "dist/**/*",
      "package.json",
      "server/**/*",
      "web/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "win": {
      "target": "nsis"
    }
  }
}