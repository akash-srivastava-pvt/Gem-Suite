{
  "name": "gem-suite",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:lib && node scripts/dev.js",
    "dist": "node scripts/dist.js",
    "clean": "node scripts/clean.js",
    "build": "node scripts/build.js && node scripts/copy-wasm.js",
    "build:lib": "npm run build -w @gem/shared && npm run build -w @gem/db"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^7.2.0"
  }
}
