{
  "name": "gem-suite",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && npm run build:lib && node scripts/dev.js",
    "dist": "node scripts/dist.js",
    "clean": "node scripts/clean.js",
    "build": "node scripts/build.js && node scripts/copy-wasm.js",
    "build:lib": "npm run build -w @gem/shared && npm run build -w @gem/db",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:fast": "vitest run --threads=false",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "c8": "^8.0.0",
    "concurrently": "^8.2.0",
    "dotenv": "^16.3.1",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "fs-extra": "^11.2.0",
    "husky": "^8.0.0",
    "jsdom": "^22.1.0",
    "lint-staged": "^13.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  }
}